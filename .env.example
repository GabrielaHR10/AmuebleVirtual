# Copia este archivo como .env y completa lo que necesites. Nunca subas .env a git.

# Token gratis de Hugging Face (opcional, solo para el retoque IA y foto→3D).
# Créalo en https://huggingface.co/settings/tokens (tipo "Read").
HF_TOKEN=

# Dispositivo de cómputo: auto | cpu | mps | cuda
DEVICE=auto

# Precisión del análisis de fotos sin tarjeta gráfica (0 rápido … 9 máximo). Por defecto 5.
MOGE_CPU_LEVEL=5

# IA local opcional (Ollama) para sugerir ubicación y leer tablas de medidas
OLLAMA_URL=http://localhost:11434
VLM_MODEL=qwen3-vl:4b-instruct
